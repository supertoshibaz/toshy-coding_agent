        '[as9v4cJI8ZCCerfh-AxWo]:code "Code"':
          data:
            allowConsole: true
            allowFetch: true
            allowProcess: false
            allowRequire: false
            allowRivet: false
            code: >-
              //
              ============================================================================

              // 1. БЕЗОПАСНОЕ ИЗВЛЕЧЕНИЕ ДАННЫХ ИЗ RIVET

              // ============================================================================

              let history = [];

              if (inputs.messages) {
                  if (Array.isArray(inputs.messages)) history = inputs.messages;
                  else if (Array.isArray(inputs.messages.value)) history = inputs.messages.value;
              }


              let textResponse = "";

              if (inputs.response) {
                  if (typeof inputs.response === 'string') textResponse = inputs.response;
                  else if (typeof inputs.response.value === 'string') textResponse = inputs.response.value;
              }


              let firstCall = null;

              let calls = inputs.function_call;


              if (calls) {
                  if (calls.type === 'object[]' && Array.isArray(calls.value)) calls = calls.value;
                  else if (calls.type === 'object' && calls.value) calls = [calls.value];
                  
                  if (Array.isArray(calls) && calls.length > 0) {
                      firstCall = calls[0];
                      if (firstCall && firstCall.value) firstCall = firstCall.value;
                  } else if (typeof calls === 'object' && !Array.isArray(calls)) {
                      firstCall = calls;
                  }
              }


              // ============================================================================

              // ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ

              // ============================================================================

              async function fetchAndCleanPage(url, maxLength) {
                  try {
                      const controller = new AbortController();
                      const timeoutId = setTimeout(() => controller.abort(), 10000);
                      const res = await fetch(url, { signal: controller.signal, headers: { 'User-Agent': 'Mozilla/5.0' } });
                      clearTimeout(timeoutId);
                      
                      if (!res.ok) return null; 
                      
                      let html = await res.text();
                      html = html.replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, ' ');
                      html = html.replace(/<style\b[^<]*(?:(?!<\/style>)<[^<]*)*<\/style>/gi, ' ');
                      let text = html.replace(/<[^>]+>/g, ' ');
                      text = text.replace(/&nbsp;/g, ' ').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&');
                      text = text.replace(/\s+/g, ' ').trim();
                      return text.substring(0, maxLength);
                  } catch (e) { 
                      return null; 
                  }
              }


              async function saveToMemory(text, source) {
                  try {
                      await fetch('http://localhost:3001/internal/memory/store', {
                          method: 'POST',
                          headers: { 'Content-Type': 'application/json' },
                          body: JSON.stringify({ text, source })
                      });
                      return true;
                  } catch (e) { 
                      console.log("* DISPATCHER ERROR: Failed to save to memory:", e.message);
                      return false; 
                  }
              }


              // ============================================================================

              // ЛОГИРОВАНИЕ И ПРОВЕРКА ИНСТРУМЕНТОВ

              // ============================================================================

              console.log(`\n--- [DISPATCHER ITERATION] ---`);

              console.log(`* Tool Called: ${firstCall ? `YES (${firstCall.name})` : 'NO'}`);


              const allowedTools = [
                  'lite_web_search', 
                  'deep_web_search', 
                  'read_url', 
                  'search_memory', 
                  'remember_this', 
                  'forget_this', 
                  'list_memories'
              ];


              // ============================================================================

              // СЦЕНАРИЙ А: ВЫЗОВ ИНСТРУМЕНТА

              // ============================================================================

              if (firstCall && allowedTools.includes(firstCall.name)) {
                  
                  let args = {};
                  try {
                      if (typeof firstCall.arguments === 'string') args = JSON.parse(firstCall.arguments);
                      else if (firstCall.arguments) args = firstCall.arguments;
                  } catch (e) {
                      console.log("* DISPATCHER ERROR: Failed to parse arguments");
                  }
                  
                  let searchResults = "";
                  const toolName = firstCall.name;
                  
                  try {
                      //lite search
                      if (toolName === 'lite_web_search') {
                          let query = args.query || "unknown query";
                          console.log(`* DISPATCHER: Executing lite web search for: "${query}"`);
                          
                          const res = await fetch('https://lite.duckduckgo.com/lite/', { 
                              method: 'POST', 
                              headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'User-Agent': 'Mozilla/5.0' }, 
                              body: `q=${encodeURIComponent(query)}` 
                          });
                          const html = await res.text();
                          
                          const regex = /<td class='result-snippet'>([\s\S]*?)<\/td>/gi;
                          let matches; 
                          let snippets = [];
                          while ((matches = regex.exec(html)) !== null && snippets.length < 4) {
                              snippets.push("- " + matches[1].replace(/(<([^>]+)>)/gi, "").trim());
                          }
                          searchResults = snippets.length > 0 ? "WEB SEARCH RESULTS:\n" + snippets.join("\n\n") : "No results found.";
                      } 
                      
                      //deep search
                      else if (toolName === 'deep_web_search') {
                          let query = args.query || "unknown query";
                          console.log(`* DISPATCHER: Executing deep web search for: "${query}"`);
                          
                          const res = await fetch('https://lite.duckduckgo.com/lite/', { 
                              method: 'POST', 
                              headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'User-Agent': 'Mozilla/5.0' }, 
                              body: `q=${encodeURIComponent(query)}` 
                          });
                          const html = await res.text();
                          
                          const urlRegex = /href=(["'])(.*?)\1/gi;
                          let match; 
                          const rawUrls = [];
                          
                          while ((match = urlRegex.exec(html)) !== null) {
                              let u = match[2];
                              if (u.includes('uddg=')) { 
                                  const uddgMatch = /uddg=([^&]+)/.exec(u); 
                                  if (uddgMatch) u = decodeURIComponent(uddgMatch[1]); 
                              }
                              if (u.startsWith('http') && !u.includes('duckduckgo.com')) {
                                  rawUrls.push(u);
                              }
                          }
                          
                          const uniqueUrls = [...new Set(rawUrls)].slice(0, 3);
                          
                          if (uniqueUrls.length === 0) {
                              searchResults = "ERROR: No valid URLs found.";
                          } else {
                              let savedCount = 0;
                              for (const u of uniqueUrls) { 
                                  console.log(`  -> Fetching and saving: ${u}`);
                                  const text = await fetchAndCleanPage(u, 10000); 
                                  if (text && await saveToMemory(text, u)) {
                                      savedCount++; 
                                  }
                              }
                              searchResults = `SYSTEM MESSAGE: Read and saved ${savedCount} pages to temporary memory. Use 'search_memory' tool to ask specific questions.`;
                          }
                      } 
                      
                      //read url
                      else if (toolName === 'read_url') {
                          let rawUrl = args.url || "";
                          let urlMatch = rawUrl.match(/https?:\/\/[^\s"'>]+/i);
                          let urlToRead = urlMatch ? urlMatch[0] : rawUrl.trim();
                          
                          console.log(`* DISPATCHER: Reading URL: ${urlToRead}`);
                          
                          if (!urlToRead.startsWith('http')) {
                              searchResults = "ERROR: Invalid URL.";
                          } else {
                              const text = await fetchAndCleanPage(urlToRead, 40000);
                              if (text && await saveToMemory(text, urlToRead)) {
                                  searchResults = `SYSTEM MESSAGE: Page saved to temporary memory. Use 'search_memory' tool to extract details.`;
                              } else {
                                  searchResults = "ERROR: Failed to read or save the page.";
                              }
                          }
                      }
                      
                      //search memories
                      else if (toolName === 'search_memory') {
                          let searchQuery = args.query || "";
                          console.log(`* DISPATCHER: Searching memory for: "${searchQuery}"`);
                          
                          const res = await fetch('http://localhost:3001/internal/memory/search', { 
                              method: 'POST', 
                              headers: { 'Content-Type': 'application/json' }, 
                              body: JSON.stringify({ query: searchQuery }) 
                          });
                          const data = await res.json();
                          searchResults = data.results || "No information found in memory.";
                      }
                      
                      //remember this
                      else if (toolName === 'remember_this') {
                          let factToSave = args.fact || args.query || args.text || "";
                          if (!factToSave && typeof args === 'string') factToSave = args;
                          if (!factToSave) factToSave = JSON.stringify(args);
                          
                          console.log(`* DISPATCHER: Saving permanent memory: "${factToSave}"`);
                          
                          const res = await fetch('http://localhost:3001/internal/memory/permanent/store', { 
                              method: 'POST', 
                              headers: { 'Content-Type': 'application/json' }, 
                              body: JSON.stringify({ fact: factToSave }) 
                          });
                          const data = await res.json();
                          
                          if (data.success) {
                              searchResults = `SYSTEM MESSAGE: Successfully saved to permanent memory with ID: ${data.id}`;
                          } else {
                              searchResults = `SYSTEM ERROR: Failed to save memory. Reason: ${data.error || 'Unknown'}`;
                          }
                      }
                      
                      //forget this
                      else if (toolName === 'forget_this') {
                          let idToDelete = args.id || "";
                          console.log(`* DISPATCHER: Deleting permanent memory ID: ${idToDelete}`);
                          
                          const res = await fetch('http://localhost:3001/internal/memory/permanent/delete', { 
                              method: 'POST', 
                              headers: { 'Content-Type': 'application/json' }, 
                              body: JSON.stringify({ id: idToDelete }) 
                          });
                          const data = await res.json();
                          
                          if (data.success) {
                              searchResults = `SYSTEM MESSAGE: Successfully deleted memory with ID: ${idToDelete}`;
                          } else {
                              searchResults = `SYSTEM ERROR: Failed to delete. Error: ${data.error}`;
                          }
                      }
                      
                      //list memories
                      else if (toolName === 'list_memories') {
                          console.log(`* DISPATCHER: Requesting permanent memory list...`);
                          
                          const res = await fetch('http://localhost:3001/internal/memory/permanent/list');
                          const data = await res.json();
                          searchResults = data.results || "SYSTEM ERROR: Failed to fetch memory list.";
                      }
                      
                  } catch (error) {
                      searchResults = `Error performing ${toolName}: ${error.message}`;
                      console.log(`* DISPATCHER ERROR: ${searchResults}`);
                  }

                  // Сохраняем вызов функции в историю
                  const newMessages = [...history];
                  newMessages.push({
                      type: 'assistant',
                      message: textResponse || "", 
                      function_call: { 
                          name: toolName, 
                          arguments: typeof firstCall.arguments === 'string' ? firstCall.arguments : JSON.stringify(firstCall.arguments) 
                      }
                  });
                  
                  // Сохраняем результат выполнения
                  newMessages.push({ type: 'function', name: toolName, message: searchResults });

                  return { 
                      updated_messages: { type: 'chat-message[]', value: newMessages }, 
                      continue_loop: { type: 'string', value: "true" }, 
                      final_text: { type: 'string', value: "" } 
                  };
              }


              // ============================================================================

              // СЦЕНАРИЙ Б: ФИНАЛЬНЫЙ ОТВЕТ (БЕЗ ФУНКЦИЙ)

              // ============================================================================

              console.log(`* DISPATCHER: No tools requested. Stopping loop.`);


              const finalMessages = [...history];

              if (textResponse) {
                  finalMessages.push({ type: 'assistant', message: textResponse });
              }


              return {
                  updated_messages: { type: 'chat-message[]', value: finalMessages },
                  continue_loop: { type: 'string', value: "false" },
                  final_text: { type: 'string', value: textResponse }
              };
            inputNames:
              - messages
              - response
              - function_call
              - ""
            outputNames:
              - updated_messages
              - continue_loop
              - final_text
